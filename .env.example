# Firebase 웹 앱 설정 (공개되어도 되는 값 — 보호는 Firestore 규칙이 담당)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 글쓰기 권한을 가진 관리자 이메일 (쉼표 구분)
VITE_ADMIN_EMAILS=totoriverce@gmail.com

# 이미지 업로드용 Cloudflare Worker 엔드포인트 (R2)
VITE_UPLOAD_ENDPOINT=https://blog-worker.totoriverce.workers.dev

# 쿠팡 파트너스 추적 코드 (AF 로 시작). 없으면 배너가 그려지지 않는다.
# 위젯 id 는 여기서 숫자만 뽑아 쓰므로 따로 넣지 않아도 된다.
VITE_COUPANG_TRACKING_CODE=
# 위젯 id 가 추적 코드와 다른 경우에만 채운다
VITE_COUPANG_PARTNER_ID=

# 카카오 애드핏 광고 단위 ID (DAN-으로 시작). 없으면 스크립트를 부르지도 않는다.
VITE_ADFIT_UNIT_ID=

# 구글 애드센스. 게시자 ID 는 ca-pub- 으로 시작하고 ads.txt 생성에도 쓰인다.
# 둘 다 있어야 광고가 그려지고, 없으면 스크립트를 받지도 않는다.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
