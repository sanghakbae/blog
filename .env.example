# 글쓰기 권한을 가진 관리자 이메일 (쉼표 구분)
VITE_ADMIN_EMAILS=qa@muhayu.com

# 이미지 업로드용 Cloudflare Worker 엔드포인트 (R2)
VITE_UPLOAD_ENDPOINT=https://img.sanghak.kr
