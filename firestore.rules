rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 ────────────────────────────────────────────────────────────────

    // 글쓰기 권한을 가진 관리자 계정
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['totoriverce@gmail.com'];
    }

    // 관리 콘솔의 보안 설정. 문서가 없으면 기본값(잠금 해제)으로 본다.
    function settings() {
      return exists(/databases/$(database)/documents/settings/security)
        ? get(/databases/$(database)/documents/settings/security).data
        : {};
    }

    function postingUnlocked() {
      return settings().get('postingLocked', false) == false;
    }

    function validPost(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 200000
        && d.published is bool
        && d.tags is list && d.tags.size() <= 3;   // 게시물당 태그 최대 3개
    }

    // ── 게시물 ──────────────────────────────────────────────────────────────

    match /posts/{postId} {
      // 발행된 글은 누구나, 임시저장은 관리자만
      allow get, list: if resource.data.published == true || isAdmin();

      // 글쓰기 잠금이 켜져 있으면 관리자라도 쓸 수 없다
      allow create, update: if isAdmin() && postingUnlocked() && validPost(request.resource.data);
      allow delete: if isAdmin() && postingUnlocked();

      // ── 좋아요 표식 ─────────────────────────────────────────────────────

      // 문서 ID 가 uid 라 한 사람이 한 번만 남길 수 있다. 남의 것은 건드리지
      // 못하고, 누가 눌렀는지는 본인과 관리자만 본다 — 합계는 stats 에 있다.
      match /likes/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list: if isAdmin();
        allow create, delete: if request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
        allow update: if false;
      }

      // ── 댓글 ────────────────────────────────────────────────────────────
      match /comments/{commentId} {
        function validComment(d) {
          return d.body is string && d.body.size() > 0 && d.body.size() <= 1000
            && d.authorUid == request.auth.uid
            && d.authorName is string && d.authorName.size() <= 60
            && d.createdAt == request.time;
        }

        // 발행된 글의 댓글은 누구나 읽는다
        allow get, list: if get(/databases/$(database)/documents/posts/$(postId)).data.published == true
          || isAdmin();

        // 로그인한 사용자만 자기 이름으로 남길 수 있다
        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && validComment(request.resource.data);

        // 수정은 작성자 본인만. 본문과 수정 시각 외의 필드는 바꿀 수 없어
        // 작성자나 작성 시각을 위조할 수 없다. 관리자도 남의 댓글은 고치지 못한다.
        allow update: if request.auth != null
          && request.auth.uid == resource.data.authorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.editedAt == request.time;
        allow delete: if isAdmin() || request.auth.uid == resource.data.authorUid;
      }
    }

    // ── 조회수·좋아요 ───────────────────────────────────────────────────────

    /**
     * stats/{postId} 에 views 와 likes 를 센다.
     *
     * 누구나 쓸 수 있게 열되, 쓸 수 있는 모양을 좁힌다. 한 번에 한 필드만,
     * 값은 정확히 1 만큼만 움직인다. 그래서 임의의 수를 적어 넣거나 남의
     * 좋아요를 지울 수 없다. 반복 호출로 부풀리는 것까지는 막지 못하지만,
     * 그것은 규칙이 아니라 집계의 성격이 감당할 몫이다.
     */
    match /stats/{postId} {
      allow get, list: if true;

      function onlyFields(keys) {
        return request.resource.data.keys().hasOnly(keys);
      }
      // 문서가 없을 때의 첫 쓰기 — 1 에서 시작한다
      allow create: if onlyFields(['views', 'likes'])
        && (!('views' in request.resource.data) || request.resource.data.views == 1)
        && (!('likes' in request.resource.data) || request.resource.data.likes == 1);

      function bumped(field, delta) {
        return request.resource.data[field] == resource.data.get(field, 0) + delta;
      }
      function untouched(field) {
        return request.resource.data.get(field, 0) == resource.data.get(field, 0);
      }
      // 조회수는 누구나 1 씩 올린다
      allow update: if onlyFields(['views', 'likes'])
        && ((bumped('views', 1) && untouched('likes'))
          // 좋아요는 로그인한 사람만, 자기 표식과 함께만 움직인다
          || (request.auth != null && untouched('views')
              && (bumped('likes', 1) || bumped('likes', -1))));

      allow delete: if false;
    }

    // ── 태그 집계 ───────────────────────────────────────────────────────────

    match /tags/{tagId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // ── 보안 설정 ───────────────────────────────────────────────────────────

    match /settings/security {
      // 에디터가 잠금 상태를 읽어야 하므로 관리자에게만 읽기를 연다
      allow get: if isAdmin();
      allow write: if isAdmin();
    }

    // ── 운영 요약 ───────────────────────────────────────────────────────────

    // 색인 갱신이 남기는 요약 한 장. 어떤 글이 아직 색인되지 않았는지는
    // 운영 정보라 방문자에게 보일 것이 아니다. 쓰는 쪽은 서비스 계정(관리자
    // 규칙을 우회한다)이므로 여기서는 읽기만 열고 쓰기는 막는다.
    match /meta/{docId} {
      allow get: if isAdmin();
      allow write: if false;
    }

    // ── 감사 로그 ───────────────────────────────────────────────────────────

    match /audit/{entryId} {
      allow get, list: if isAdmin();

      // 추가만 가능. 수정·삭제는 관리자도 할 수 없어 기록이 남는다.
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
